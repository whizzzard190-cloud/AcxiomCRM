@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = $"Lead - {Model.LeadName}";
    var statusBadge = Model.Status switch {
        "New" => "bg-primary-subtle text-primary",
        "Contacted" => "bg-info-subtle text-info",
        "Qualified" => "bg-warning-subtle text-warning",
        "Converted" => "bg-success-subtle text-success",
        "Lost" => "bg-danger-subtle text-danger",
        _ => "bg-secondary-subtle text-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0">@Model.LeadName</h2>
            <span class="badge bg-light text-dark border">@Model.LeadCode</span>
            <span class="badge @statusBadge">@Model.Status</span>
            <span class="badge bg-secondary">Priority: @Model.Priority</span>
        </div>
        <p class="text-muted small mb-0">
            Assigned to: <strong>@(Model.AssignedUser?.FullName ?? "Unassigned")</strong> |
            Created: @Model.CreatedDate.ToString("MMM dd, yyyy")
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status == "Qualified")
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm">
                <i class="bi bi-arrow-right-circle-fill me-1"></i> Convert to Customer
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-info btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Follow-Up
        </a>
        <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-journal-plus me-1"></i> Activity
        </a>
        <a asp-action="Index" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<!-- Quick Workflow Transition Bar -->
@if (Model.Status != "Converted" && Model.Status != "Lost")
{
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span class="small fw-semibold text-muted">
                <i class="bi bi-arrow-right-circle me-1"></i> Advance Pipeline Status:
            </span>
            <div class="d-flex gap-2">
                @if (Model.Status == "New")
                {
                    <form asp-action="ChangeStatus" asp-route-id="@Model.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Contacted" />
                        <button type="submit" class="btn btn-sm btn-info text-white">
                            <i class="bi bi-telephone-outbound me-1"></i> Mark as Contacted
                        </button>
                    </form>
                }
                @if (Model.Status == "Contacted")
                {
                    <form asp-action="ChangeStatus" asp-route-id="@Model.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Qualified" />
                        <button type="submit" class="btn btn-sm btn-warning">
                            <i class="bi bi-check-circle me-1"></i> Qualify Lead
                        </button>
                    </form>
                    <form asp-action="ChangeStatus" asp-route-id="@Model.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Unqualified" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-dash-circle me-1"></i> Mark Unqualified
                        </button>
                    </form>
                }
                @if (Model.Status == "Unqualified")
                {
                    <form asp-action="ChangeStatus" asp-route-id="@Model.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Contacted" />
                        <button type="submit" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Re-contact Lead
                        </button>
                    </form>
                }
                <form asp-action="ChangeStatus" asp-route-id="@Model.LeadId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="newStatus" value="Lost" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-x-circle me-1"></i> Mark as Lost
                    </button>
                </form>
            </div>
        </div>
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle text-primary me-2"></i>Lead Information</h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-3">
                        <small class="text-muted d-block">Company</small>
                        <span class="fw-semibold">@(Model.CompanyName ?? "N/A")</span>
                    </li>
                    <li class="mb-3">
                        <small class="text-muted d-block">Email</small>
                        <a href="mailto:@Model.Email" class="text-decoration-none fw-semibold">@Model.Email</a>
                    </li>
                    <li class="mb-3">
                        <small class="text-muted d-block">Phone</small>
                        <span class="fw-semibold">@Model.Phone</span>
                    </li>
                    <li class="mb-3">
                        <small class="text-muted d-block">Expected Value</small>
                        <span class="fs-5 fw-bold text-success">@Model.ExpectedValue.ToString("C0")</span>
                    </li>
                    <li class="mb-3">
                        <small class="text-muted d-block">Source</small>
                        <span>@(Model.Source ?? "Not specified")</span>
                    </li>
                    @if (Model.ConvertedCustomer != null)
                    {
                        <li class="mb-3 p-2 bg-success-subtle rounded border border-success-subtle">
                            <small class="text-success fw-bold d-block"><i class="bi bi-check2-all"></i> Converted Customer</small>
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomer.CustomerId" class="fw-semibold text-success">
                                @Model.ConvertedCustomer.CustomerName (@Model.ConvertedCustomer.CustomerCode)
                            </a>
                        </li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <li class="mb-0">
                            <small class="text-muted d-block">Notes</small>
                            <div class="p-2 bg-light rounded small mt-1">@Model.Notes</div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom">
                <ul class="nav nav-tabs card-header-tabs" id="leadTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" id="leadFollowups-tab" data-bs-toggle="tab" data-bs-target="#leadFollowups" type="button" role="tab">
                            <i class="bi bi-calendar-check me-1"></i> Follow-Ups (@Model.FollowUps.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="leadActivities-tab" data-bs-toggle="tab" data-bs-target="#leadActivities" type="button" role="tab">
                            <i class="bi bi-clock-history me-1"></i> Activities (@Model.Activities.Count)
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body p-3">
                <div class="tab-content" id="leadTabsContent">
                    <!-- Follow-ups tab -->
                    <div class="tab-pane fade show active" id="leadFollowups" role="tabpanel">
                        @if (!Model.FollowUps.Any())
                        {
                            <div class="text-center py-4 text-muted small">
                                <i class="bi bi-calendar-check display-6 d-block mb-2"></i>
                                No follow-ups scheduled for this lead.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0 small">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Type</th>
                                            <th>Subject</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var f in Model.FollowUps)
                                        {
                                            <tr>
                                                <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                                <td class="fw-semibold">@f.Subject</td>
                                                <td>@f.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                                <td>
                                                    <span class="badge @(f.Status == "Completed" ? "bg-success" : f.IsOverdue ? "bg-danger" : "bg-warning text-dark")">
                                                        @(f.IsOverdue ? "Overdue" : f.Status)
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <!-- Activities tab -->
                    <div class="tab-pane fade" id="leadActivities" role="tabpanel">
                        @if (!Model.Activities.Any())
                        {
                            <div class="text-center py-4 text-muted small">
                                <i class="bi bi-clock-history display-6 d-block mb-2"></i>
                                No activities recorded for this lead yet.
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var act in Model.Activities.OrderByDescending(a => a.ActivityDate))
                                {
                                    <div class="list-group-item px-0 py-2">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1 fw-bold small">
                                                <i class="bi @(act.ActivityType == "Call" ? "bi-telephone" : act.ActivityType == "Meeting" ? "bi-people" : act.ActivityType == "Email" ? "bi-envelope" : "bi-check2-square") me-1 text-primary"></i>
                                                @act.Subject
                                            </h6>
                                            <small class="text-muted">@act.ActivityDate.ToString("g")</small>
                                        </div>
                                        <p class="mb-1 small text-muted">@act.Description</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
