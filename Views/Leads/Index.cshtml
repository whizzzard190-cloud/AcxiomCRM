@model AcxiomCRM.ViewModels.PagedList<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Leads";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-funnel text-primary me-2"></i>Leads</h2>
        <p class="text-muted small mb-0">Track prospect discovery, qualification status, and conversions</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill me-1"></i> Add Lead
    </a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center mb-3">
            <div class="col-md-5">
                <partial name="_SearchBar" model='(Model.Pager.SearchTerm, "Search leads by name, email, phone, company, code...", "Index", "Leads")' />
            </div>
            <div class="col-md-3">
                <div class="btn-group w-100" role="group">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm @(string.IsNullOrEmpty(ViewBag.CurrentStatus) ? "active" : "")">All</a>
                    <a asp-action="Index" asp-route-status="New" class="btn btn-outline-secondary btn-sm @(ViewBag.CurrentStatus == "New" ? "active" : "")">New</a>
                    <a asp-action="Index" asp-route-status="Contacted" class="btn btn-outline-secondary btn-sm @(ViewBag.CurrentStatus == "Contacted" ? "active" : "")">Contacted</a>
                    <a asp-action="Index" asp-route-status="Qualified" class="btn btn-outline-secondary btn-sm @(ViewBag.CurrentStatus == "Qualified" ? "active" : "")">Qualified</a>
                </div>
            </div>
            <div class="col-md-4 text-md-end text-muted small">
                Showing <strong>@Model.Items.Count</strong> of <strong>@Model.Pager.TotalRecords</strong> records
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th>Code</th>
                        <th>
                            <a asp-action="Index" asp-route-sortBy="name" 
                               asp-route-sortOrder="@(Model.Pager.SortBy == "name" && Model.Pager.SortOrder != "desc" ? "desc" : "asc")"
                               asp-route-search="@Model.Pager.SearchTerm" class="text-decoration-none text-muted">
                                Lead Name <i class="bi bi-arrow-down-up small"></i>
                            </a>
                        </th>
                        <th>Company</th>
                        <th>Expected Value</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Assigned To</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-funnel fs-2 d-block mb-2"></i>
                                No leads found matching your criteria.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        var statusBadge = item.Status switch {
                            "New" => "bg-primary-subtle text-primary",
                            "Contacted" => "bg-info-subtle text-info",
                            "Qualified" => "bg-warning-subtle text-warning",
                            "Converted" => "bg-success-subtle text-success",
                            "Lost" => "bg-danger-subtle text-danger",
                            _ => "bg-secondary-subtle text-secondary"
                        };
                        var priorityBadge = item.Priority switch {
                            "High" => "bg-danger text-white",
                            "Medium" => "bg-warning text-dark",
                            _ => "bg-secondary text-white"
                        };

                        <tr>
                            <td><span class="badge bg-light text-dark border">@item.LeadCode</span></td>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@item.LeadId" class="text-decoration-none text-dark">
                                    @item.LeadName
                                </a>
                                <div class="text-muted small">@item.Email | @item.Phone</div>
                            </td>
                            <td>@(item.CompanyName ?? "-")</td>
                            <td class="fw-bold">@item.ExpectedValue.ToString("C0")</td>
                            <td><span class="badge @statusBadge">@item.Status</span></td>
                            <td><span class="badge @priorityBadge">@item.Priority</span></td>
                            <td>
                                <span class="badge bg-light text-secondary border">
                                    @(item.AssignedUser?.FullName ?? "Unassigned")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (item.Status == "Qualified")
                                    {
                                        <a asp-action="Convert" asp-route-id="@item.LeadId" class="btn btn-outline-success" title="Convert to Customer">
                                            <i class="bi bi-arrow-right-circle"></i> Convert
                                        </a>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.LeadId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.LeadId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (item.Status != "Converted" && item.Status != "Lost")
                                    {
                                        <button type="button" class="btn btn-outline-danger" title="Mark as Lost"
                                                onclick="showDeleteModal('@Url.Action("Deactivate", "Leads", new { id = item.LeadId })', 'Are you sure you want to mark lead @item.LeadName as Lost?', 'Mark Lost')">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pager" model="Model.Pager" />
    </div>
</div>
