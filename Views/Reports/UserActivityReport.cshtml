@model List<AcxiomCRM.Services.UserActivityReportItem>
@{
    ViewData["Title"] = "User Activity Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-activity text-primary me-2"></i>User Activity Report</h2>
        <p class="text-muted small mb-0">Productivity analysis across team members</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="UserActivityReport" asp-route-export="true" 
           asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" 
           class="btn btn-outline-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Home
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>User Name</th>
                        <th>Calls</th>
                        <th>Meetings</th>
                        <th>Emails</th>
                        <th>Tasks</th>
                        <th class="text-end">Total Logged Activities</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">No activity records logged in the specified period.</td></tr>
                    }
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@u.UserName</td>
                            <td>@u.Calls</td>
                            <td>@u.Meetings</td>
                            <td>@u.Emails</td>
                            <td>@u.Tasks</td>
                            <td class="text-end fw-bold text-primary">@u.TotalActivities</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
