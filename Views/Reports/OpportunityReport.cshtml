@model List<AcxiomCRM.Services.OpportunityReportItem>
@{
    ViewData["Title"] = "Opportunity Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-briefcase text-primary me-2"></i>Opportunity Report</h2>
        <p class="text-muted small mb-0">Total deals: @Model.Count | Total Value: @Model.Sum(o => o.Amount).ToString("C0")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="OpportunityReport" asp-route-export="true" 
           asp-route-stage="@ViewBag.Stage" asp-route-status="@ViewBag.Status"
           asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" 
           class="btn btn-outline-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Home
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="OpportunityReport" class="row g-2 align-items-end mb-3">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Stage</label>
                <select name="stage" class="form-select form-select-sm">
                    <option value="">-- All --</option>
                    <option value="Qualification" selected="@(ViewBag.Stage == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(ViewBag.Stage == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(ViewBag.Stage == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(ViewBag.Stage == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.Stage == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">-- All --</option>
                    <option value="Open" selected="@(ViewBag.Status == "Open")">Open</option>
                    <option value="Won" selected="@(ViewBag.Status == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.Status == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">From</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">To</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Deal Name</th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Stage</th>
                        <th>Prob %</th>
                        <th>Weighted Value</th>
                        <th>Expected Close</th>
                        <th>Status</th>
                        <th>Owner</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center py-4 text-muted">No records match the filter criteria.</td></tr>
                    }
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@r.Name</td>
                            <td>@r.Customer</td>
                            <td class="fw-bold">@r.Amount.ToString("C0")</td>
                            <td><span class="badge bg-light text-dark border">@r.Stage</span></td>
                            <td>@r.Probability%</td>
                            <td class="text-primary fw-semibold">@r.WeightedValue.ToString("C0")</td>
                            <td>@r.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge @(r.Status == "Won" ? "bg-success" : r.Status == "Lost" ? "bg-danger" : "bg-primary")">@r.Status</span></td>
                            <td>@r.Owner</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
