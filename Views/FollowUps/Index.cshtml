@model AcxiomCRM.ViewModels.PagedList<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Ups";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-calendar-check text-primary me-2"></i>Follow-Ups</h2>
        <p class="text-muted small mb-0">Never miss a commitment with prioritized task scheduling</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-calendar-plus-fill me-1"></i> Schedule Follow-Up
    </a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center mb-3">
            <div class="col-md-5">
                <partial name="_SearchBar" model='(Model.Pager.SearchTerm, "Search follow-ups by subject, remarks...", "Index", "FollowUps")' />
            </div>
            <div class="col-md-4">
                <div class="btn-group w-100" role="group">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm @(ViewBag.CurrentFilter == "all" ? "active" : "")">All</a>
                    <a asp-action="Index" asp-route-filter="upcoming" class="btn btn-outline-secondary btn-sm @(ViewBag.CurrentFilter == "upcoming" ? "active" : "")">Upcoming</a>
                    <a asp-action="Index" asp-route-filter="overdue" class="btn btn-outline-secondary btn-sm @(ViewBag.CurrentFilter == "overdue" ? "active" : "")">Overdue</a>
                    <a asp-action="Index" asp-route-filter="completed" class="btn btn-outline-secondary btn-sm @(ViewBag.CurrentFilter == "completed" ? "active" : "")">Completed</a>
                </div>
            </div>
            <div class="col-md-3 text-md-end text-muted small">
                Showing <strong>@Model.Items.Count</strong> of <strong>@Model.Pager.TotalRecords</strong> records
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th>Date & Time</th>
                        <th>Type</th>
                        <th>Subject</th>
                        <th>Associated With</th>
                        <th>Assigned To</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-calendar2-check fs-2 d-block mb-2"></i>
                                No follow-ups found for the selected view.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        var statusBadge = item.Status switch {
                            "Completed" => "bg-success text-white",
                            "Cancelled" => "bg-secondary text-white",
                            _ when item.IsOverdue => "bg-danger text-white",
                            _ => "bg-warning text-dark"
                        };

                        <tr>
                            <td class="fw-semibold">
                                @item.FollowUpDate.ToString("MMM dd, yyyy HH:mm")
                                @if (item.IsOverdue)
                                {
                                    <span class="badge bg-danger ms-1 small">Overdue</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi @(item.FollowUpType == "Call" ? "bi-telephone" : item.FollowUpType == "Meeting" ? "bi-people" : item.FollowUpType == "Email" ? "bi-envelope" : "bi-check2-square") me-1"></i>
                                    @item.FollowUpType
                                </span>
                            </td>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@item.FollowUpId" class="text-decoration-none text-dark">
                                    @item.Subject
                                </a>
                                @if (!string.IsNullOrEmpty(item.Remarks))
                                {
                                    <div class="text-muted small text-truncate" style="max-width: 280px;">@item.Remarks</div>
                                }
                            </td>
                            <td>
                                @if (item.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="badge bg-light text-primary border text-decoration-none d-block text-truncate">
                                        <i class="bi bi-building me-1"></i>@item.Customer.CustomerName
                                    </a>
                                }
                                @if (item.Lead != null)
                                {
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="badge bg-light text-info border text-decoration-none d-block text-truncate mt-1">
                                        <i class="bi bi-funnel me-1"></i>@item.Lead.LeadName
                                    </a>
                                }
                                @if (item.Opportunity != null)
                                {
                                    <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@item.OpportunityId" class="badge bg-light text-success border text-decoration-none d-block text-truncate mt-1">
                                        <i class="bi bi-briefcase me-1"></i>@item.Opportunity.OpportunityName
                                    </a>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">
                                    @(item.AssignedUser?.FullName ?? "Unassigned")
                                </span>
                            </td>
                            <td><span class="badge @statusBadge">@(item.IsOverdue ? "Overdue" : item.Status)</span></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (item.Status == "Planned")
                                    {
                                        <form asp-action="Complete" asp-route-id="@item.FollowUpId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Mark Completed">
                                                <i class="bi bi-check2"></i>
                                            </button>
                                        </form>
                                        <a asp-action="Reschedule" asp-route-id="@item.FollowUpId" class="btn btn-outline-warning" title="Reschedule">
                                            <i class="bi bi-clock-history"></i>
                                        </a>
                                        <form asp-action="Cancel" asp-route-id="@item.FollowUpId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Cancel Follow-Up">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.FollowUpId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pager" model="Model.Pager" />
    </div>
</div>
