@model AcxiomCRM.Models.Activity
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-journal-plus text-primary me-2"></i>Log New Activity</h5>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <partial name="_ValidationSummary" />

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Subject" class="form-label fw-semibold">Subject / Title <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Discovery call with technical leadership" autofocus />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ActivityType" class="form-label fw-semibold">Activity Type <span class="text-danger">*</span></label>
                            <select asp-for="ActivityType" class="form-select">
                                <option value="Call">Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Task">Task</option>
                            </select>
                            <span asp-validation-for="ActivityType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ActivityDate" class="form-label fw-semibold">Date & Time <span class="text-danger">*</span></label>
                            <input asp-for="ActivityDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Completed">Completed</option>
                                <option value="Planned">Planned</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold">Associate Customer</label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                                <option value="">-- None --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold">Associate Lead</label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.Leads">
                                <option value="">-- None --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold">Assigned User</label>
                                <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.Users">
                                    <option value="">-- Assign to Me (Default) --</option>
                                </select>
                                <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Description / Meeting Notes</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter key takeaways, discussed action items, attendees..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Save Activity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
