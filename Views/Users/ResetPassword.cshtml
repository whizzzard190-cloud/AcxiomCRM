@model AcxiomCRM.ViewModels.AdminResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-key text-primary me-2"></i>Reset User Password</h5>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <partial name="_ValidationSummary" />

                <div class="p-3 bg-light rounded border mb-3">
                    <small class="text-muted d-block">Target Account</small>
                    <strong class="d-block text-dark">@Model.FullName</strong>
                    <small class="text-muted">@Model.Email</small>
                </div>

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="FullName" />
                    <input type="hidden" asp-for="Email" />

                    <div class="mb-4">
                        <label asp-for="NewPassword" class="form-label fw-semibold">New Password <span class="text-danger">*</span></label>
                        <input asp-for="NewPassword" class="form-control" placeholder="Min. 8 characters with upper, lower, digit, symbol" autofocus />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2-circle me-1"></i> Set Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
