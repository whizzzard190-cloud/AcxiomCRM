@model AcxiomCRM.ViewModels.PagedList<AcxiomCRM.ViewModels.UserItemViewModel>
@{
    ViewData["Title"] = "User Management";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people text-primary me-2"></i>User Management</h2>
        <p class="text-muted small mb-0">System access, role authorizations, hierarchy assignments, and account lockouts</p>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill me-1"></i> Add User
        </a>
    }
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <div class="row align-items-center mb-3">
            <div class="col-md-6">
                <partial name="_SearchBar" model='(Model.Pager.SearchTerm, "Search users by name or email...", "Index", "Users")' />
            </div>
            <div class="col-md-6 text-md-end text-muted small">
                Showing <strong>@Model.Items.Count</strong> of <strong>@Model.Pager.TotalRecords</strong> users
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Reporting Manager</th>
                        <th>Status</th>
                        <th>Lockout</th>
                        @if (isAdmin)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="@(isAdmin ? 6 : 5)" class="text-center py-4 text-muted">
                                <i class="bi bi-person-x fs-2 d-block mb-2"></i>
                                No users found matching your search.
                            </td>
                        </tr>
                    }
                    @foreach (var user in Model.Items)
                    {
                        var roleBadge = user.Role switch {
                            "Admin" => "bg-danger",
                            "Manager" => "bg-warning text-dark",
                            _ => "bg-info text-dark"
                        };

                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">@user.FullName</div>
                                <div class="small text-muted">@user.Email</div>
                            </td>
                            <td><span class="badge @roleBadge">@user.Role</span></td>
                            <td>@(user.ManagerName ?? "-")</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger">Deactivated</span>
                                }
                            </td>
                            <td>
                                @if (user.IsLockedOut)
                                {
                                    <span class="badge bg-danger text-white">Locked Out</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border">Normal</span>
                                }
                            </td>
                            @if (isAdmin)
                            {
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Edit User">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-outline-secondary" title="Reset Password">
                                            <i class="bi bi-key"></i>
                                        </a>
                                        @if (user.IsLockedOut)
                                        {
                                            <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning" title="Unlock Account">
                                                    <i class="bi bi-unlock"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pager" model="Model.Pager" />
    </div>
</div>
