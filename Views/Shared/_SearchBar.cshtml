@model (string? SearchTerm, string Placeholder, string Action, string Controller)

<form method="get" asp-action="@Model.Action" asp-controller="@Model.Controller" class="d-flex align-items-center gap-2 mb-3">
    <div class="input-group">
        <span class="input-group-text bg-light border-end-0">
            <i class="bi bi-search text-muted"></i>
        </span>
        <input type="text" name="search" class="form-control border-start-0 ps-0" 
               placeholder="@Model.Placeholder" value="@Model.SearchTerm" />
        <button class="btn btn-primary" type="submit">
            Search
        </button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a asp-action="@Model.Action" asp-controller="@Model.Controller" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i> Clear
            </a>
        }
    </div>
</form>
