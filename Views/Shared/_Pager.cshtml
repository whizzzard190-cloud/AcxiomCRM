@model AcxiomCRM.ViewModels.PagerModel

@if (Model != null && Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-3">
        <ul class="pagination pagination-sm justify-content-end mb-0">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" href="@Url.Action(Model.Action, Model.Controller, GetRouteParams(Model.CurrentPage - 1))" tabindex="-1">
                    <i class="bi bi-chevron-left"></i> Previous
                </a>
            </li>

            @{
                int startPage = Math.Max(1, Model.CurrentPage - 2);
                int endPage = Math.Min(Model.TotalPages, startPage + 4);
                if (endPage - startPage < 4)
                {
                    startPage = Math.Max(1, endPage - 4);
                }
            }

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action(Model.Action, Model.Controller, GetRouteParams(i))">@i</a>
                </li>
            }

            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" href="@Url.Action(Model.Action, Model.Controller, GetRouteParams(Model.CurrentPage + 1))">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

@functions {
    private object GetRouteParams(int page)
    {
        var dict = new RouteValueDictionary();
        if (Model?.RouteValues != null)
        {
            foreach (var kvp in Model.RouteValues)
            {
                dict[kvp.Key] = kvp.Value;
            }
        }
        dict["page"] = page;
        if (!string.IsNullOrEmpty(Model?.SearchTerm)) dict["search"] = Model.SearchTerm;
        if (!string.IsNullOrEmpty(Model?.SortBy)) dict["sortBy"] = Model.SortBy;
        if (!string.IsNullOrEmpty(Model?.SortOrder)) dict["sortOrder"] = Model.SortOrder;
        return dict;
    }
}
