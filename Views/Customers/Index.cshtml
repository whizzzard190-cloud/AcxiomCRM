@model AcxiomCRM.ViewModels.PagedList<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people text-primary me-2"></i>Customers</h2>
        <p class="text-muted small mb-0">Manage and track your account relationships and clients</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i> Add Customer
    </a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <div class="row align-items-center">
            <div class="col-md-6">
                <partial name="_SearchBar" model='(Model.Pager.SearchTerm, "Search by name, email, phone, company, code...", "Index", "Customers")' />
            </div>
            <div class="col-md-6 text-md-end text-muted small">
                Showing <strong>@Model.Items.Count</strong> of <strong>@Model.Pager.TotalRecords</strong> records
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th>Code</th>
                        <th>
                            <a asp-action="Index" asp-route-sortBy="name" 
                               asp-route-sortOrder="@(Model.Pager.SortBy == "name" && Model.Pager.SortOrder != "desc" ? "desc" : "asc")"
                               asp-route-search="@Model.Pager.SearchTerm" class="text-decoration-none text-muted">
                                Customer Name <i class="bi bi-arrow-down-up small"></i>
                            </a>
                        </th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Company</th>
                        <th>Owner</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No customers found matching your criteria.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@item.CustomerCode</span></td>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none text-dark">
                                    @item.CustomerName
                                </a>
                            </td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>
                            <td>@(item.CompanyName ?? "-")</td>
                            <td>
                                <span class="badge bg-light text-secondary border">
                                    @(item.Owner?.FullName ?? "Unassigned")
                                </span>
                            </td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success-subtle text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (item.Status == "Active")
                                    {
                                        <button type="button" class="btn btn-outline-danger" title="Deactivate"
                                                onclick="showDeleteModal('@Url.Action("Deactivate", "Customers", new { id = item.CustomerId })', 'Are you sure you want to deactivate customer @item.CustomerName?', 'Deactivate')">
                                            <i class="bi bi-slash-circle"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pager" model="Model.Pager" />
    </div>
</div>
