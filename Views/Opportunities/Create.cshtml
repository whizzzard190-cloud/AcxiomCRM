@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Add Opportunity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-briefcase text-primary me-2"></i>Create New Opportunity</h5>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <partial name="_ValidationSummary" />

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="OpportunityName" class="form-label fw-semibold">Opportunity / Deal Name <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Enterprise Cloud License" autofocus />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold">Customer Account <span class="text-danger">*</span></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                                <option value="">-- Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label fw-semibold">Deal Amount (INR) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="Amount" class="form-control" type="number" step="1000" min="1" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                            <div class="form-text small">Opportunity Amount must be greater than 0.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Probability" class="form-label fw-semibold">Close Probability (%) <span class="text-danger">*</span></label>
                            <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                            <div class="form-text small">Probability must be between 0 and 100.</div>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Stage" class="form-label fw-semibold">Initial Stage <span class="text-danger">*</span></label>
                            <select asp-for="Stage" class="form-select">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold">Expected Close Date <span class="text-danger">*</span></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Source" class="form-label fw-semibold">Lead Source</label>
                            <select asp-for="Source" class="form-select">
                                <option value="Direct Sales">Direct Sales</option>
                                <option value="Website">Website</option>
                                <option value="Referral">Referral</option>
                                <option value="Partner">Partner</option>
                                <option value="Renewal">Renewal</option>
                            </select>
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold">Assigned Deal Owner</label>
                                <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.Users">
                                    <option value="">-- Assign to Me (Default) --</option>
                                </select>
                                <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold">Notes / Strategic Opportunity Details</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Enter key decision makers, competition, scope details..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Save Opportunity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
