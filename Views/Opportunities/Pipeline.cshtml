@model List<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Pipeline Board";
    string[] stages = ["Qualification", "Proposal", "Negotiation", "Won", "Lost"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-kanban text-primary me-2"></i>Sales Pipeline Board</h2>
        <p class="text-muted small mb-0">Visual stage progression and deal distribution</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-list-ul me-1"></i> List View
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill me-1"></i> Add Opportunity
        </a>
    </div>
</div>

<div class="row g-3 flex-nowrap overflow-auto pb-4">
    @foreach (var stage in stages)
    {
        var stageOpps = Model.Where(o => o.Stage == stage).ToList();
        var totalAmount = stageOpps.Sum(o => o.Amount);
        var headerClass = stage switch {
            "Qualification" => "border-info text-info",
            "Proposal" => "border-primary text-primary",
            "Negotiation" => "border-warning text-warning",
            "Won" => "border-success text-success",
            "Lost" => "border-danger text-danger",
            _ => "border-secondary text-secondary"
        };

        <div class="col-12 col-md-4 col-xl-2" style="min-width: 260px;">
            <div class="card h-100 bg-light border-0 shadow-sm">
                <div class="card-header bg-white border-top border-4 @headerClass py-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h6 class="fw-bold mb-0 text-dark">@stage</h6>
                        <span class="badge bg-secondary-subtle text-secondary">@stageOpps.Count</span>
                    </div>
                    <div class="small fw-semibold text-muted">@totalAmount.ToString("C0")</div>
                </div>
                <div class="card-body p-2 d-flex flex-column gap-2" style="max-height: 70vh; overflow-y: auto;">
                    @if (!stageOpps.Any())
                    {
                        <div class="text-center py-4 text-muted small">No deals</div>
                    }
                    @foreach (var opp in stageOpps)
                    {
                        <div class="card border shadow-sm p-3 bg-white">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="fw-bold mb-0 small">
                                    <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="text-decoration-none text-dark">
                                        @opp.OpportunityName
                                    </a>
                                </h6>
                                <span class="badge bg-light text-dark border small">@opp.Probability%</span>
                            </div>
                            <div class="small text-muted mb-2">
                                <i class="bi bi-building me-1"></i>@(opp.Customer?.CustomerName ?? "No Customer")
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <strong class="text-primary small">@opp.Amount.ToString("C0")</strong>
                                <small class="text-muted">@opp.ExpectedCloseDate.ToString("MMM dd")</small>
                            </div>

                            @if (opp.Status == "Open")
                            {
                                <div class="mt-2 pt-2 border-top d-flex gap-1 justify-content-end">
                                    @if (opp.Stage == "Qualification")
                                    {
                                        <form asp-action="ChangeStage" asp-route-id="@opp.OpportunityId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="newStage" value="Proposal" />
                                            <button type="submit" class="btn btn-outline-primary btn-sm py-0 px-1" title="Move to Proposal">
                                                <i class="bi bi-arrow-right"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (opp.Stage == "Proposal")
                                    {
                                        <form asp-action="ChangeStage" asp-route-id="@opp.OpportunityId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="newStage" value="Negotiation" />
                                            <button type="submit" class="btn btn-outline-warning btn-sm py-0 px-1" title="Move to Negotiation">
                                                <i class="bi bi-arrow-right"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (opp.Stage == "Negotiation")
                                    {
                                        <form asp-action="ChangeStage" asp-route-id="@opp.OpportunityId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="newStage" value="Won" />
                                            <button type="submit" class="btn btn-outline-success btn-sm py-0 px-1" title="Close Won">
                                                <i class="bi bi-trophy"></i>
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="ChangeStage" asp-route-id="@opp.OpportunityId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="newStage" value="Lost" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-1" title="Close Lost">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
