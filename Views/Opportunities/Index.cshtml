@model AcxiomCRM.ViewModels.PagedList<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunities";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-briefcase text-primary me-2"></i>Opportunities</h2>
        <p class="text-muted small mb-0">Track active deals, probability weighting, and pipeline velocity</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Pipeline" class="btn btn-outline-primary">
            <i class="bi bi-kanban me-1"></i> Pipeline View
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill me-1"></i> Add Opportunity
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center mb-3">
            <div class="col-md-5">
                <partial name="_SearchBar" model='(Model.Pager.SearchTerm, "Search opportunities by name, customer...", "Index", "Opportunities")' />
            </div>
            <div class="col-md-4">
                <div class="btn-group w-100" role="group">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm @(string.IsNullOrEmpty(ViewBag.CurrentStage) ? "active" : "")">All</a>
                    <a asp-action="Index" asp-route-stage="Qualification" class="btn btn-outline-secondary btn-sm @(ViewBag.CurrentStage == "Qualification" ? "active" : "")">Qual</a>
                    <a asp-action="Index" asp-route-stage="Proposal" class="btn btn-outline-secondary btn-sm @(ViewBag.CurrentStage == "Proposal" ? "active" : "")">Prop</a>
                    <a asp-action="Index" asp-route-stage="Negotiation" class="btn btn-outline-secondary btn-sm @(ViewBag.CurrentStage == "Negotiation" ? "active" : "")">Neg</a>
                    <a asp-action="Index" asp-route-stage="Won" class="btn btn-outline-secondary btn-sm @(ViewBag.CurrentStage == "Won" ? "active" : "")">Won</a>
                </div>
            </div>
            <div class="col-md-3 text-md-end text-muted small">
                Showing <strong>@Model.Items.Count</strong> of <strong>@Model.Pager.TotalRecords</strong> records
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th>
                            <a asp-action="Index" asp-route-sortBy="name" 
                               asp-route-sortOrder="@(Model.Pager.SortBy == "name" && Model.Pager.SortOrder != "desc" ? "desc" : "asc")"
                               asp-route-search="@Model.Pager.SearchTerm" class="text-decoration-none text-muted">
                                Opportunity Name <i class="bi bi-arrow-down-up small"></i>
                            </a>
                        </th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Stage</th>
                        <th>Prob %</th>
                        <th>Weighted Value</th>
                        <th>Expected Close</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="bi bi-briefcase fs-2 d-block mb-2"></i>
                                No opportunities found matching your criteria.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        var stageBadge = item.Stage switch {
                            "Qualification" => "bg-info-subtle text-info",
                            "Proposal" => "bg-primary-subtle text-primary",
                            "Negotiation" => "bg-warning-subtle text-warning",
                            "Won" => "bg-success-subtle text-success",
                            "Lost" => "bg-danger-subtle text-danger",
                            _ => "bg-secondary-subtle text-secondary"
                        };

                        <tr>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@item.OpportunityId" class="text-decoration-none text-dark">
                                    @item.OpportunityName
                                </a>
                                @if (item.Lead != null)
                                {
                                    <div class="text-muted small">Lead: @item.Lead.LeadName</div>
                                }
                            </td>
                            <td>
                                @if (item.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none text-secondary">
                                        @item.Customer.CustomerName
                                    </a>
                                }
                            </td>
                            <td class="fw-bold">@item.Amount.ToString("C0")</td>
                            <td><span class="badge @stageBadge">@item.Stage</span></td>
                            <td>@item.Probability%</td>
                            <td class="text-primary fw-semibold">@item.WeightedAmount.ToString("C0")</td>
                            <td>@item.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge @(item.Status == "Won" ? "bg-success" : item.Status == "Lost" ? "bg-danger" : "bg-primary")">
                                    @item.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.OpportunityId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.OpportunityId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (item.Status == "Open")
                                    {
                                        <button type="button" class="btn btn-outline-danger" title="Mark as Lost"
                                                onclick="showDeleteModal('@Url.Action("Deactivate", "Opportunities", new { id = item.OpportunityId })', 'Are you sure you want to mark opportunity @item.OpportunityName as Lost?', 'Mark Lost')">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pager" model="Model.Pager" />
    </div>
</div>
